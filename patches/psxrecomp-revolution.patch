index 00000000..93ed1c11
--- /dev/null
+++ b/recompiler/tests/test_revolution_reserved_guard.py
@@ -0,0 +1,31 @@
+#!/usr/bin/env python3
+"""Reserved guard must fail loudly, remain narrowly scoped, and compile in both emit modes."""
+import argparse
+from pathlib import Path
+import struct
+import subprocess
+import tempfile
+
+def main():
+    p=argparse.ArgumentParser();p.add_argument('--recompiler',type=Path,required=True);a=p.parse_args()
+    sdk=Path(__file__).resolve().parents[2]
+    with tempfile.TemporaryDirectory() as tmp:
+        root=Path(tmp);header=bytearray(2048);header[:8]=b'PS-X EXE'
+        for word in (0x00001770,0x000017b0):
+            body=struct.pack('<5I',0x27bdfff8,word,0x27bd0008,0x03e00008,0)
+            struct.pack_into('<I',header,0x10,0x80010000);struct.pack_into('<II',header,0x18,0x80010000,len(body))
+            exe=root/'guard.exe';exe.write_bytes(header+body);seeds=root/'seeds.txt';seeds.write_text('0x80010000\n')
+            for overlay in (False,True):
+                out=root/f'{word:x}-{overlay}';out.mkdir()
+                run=subprocess.run([str(a.recompiler.resolve()),str(exe),'--seeds',str(seeds),'--out-dir',str(out),*(['--overlay'] if overlay else [])],capture_output=True,text=True)
+                if run.returncode:raise RuntimeError(run.stderr+run.stdout)
+                sources=list(out.glob('*_full*.c'));text='\n'.join(s.read_text() for s in sources)
+                if word==0x00001770:
+                    assert 'Reserved division guard at 0x80010004' in text and 'abort();' in text
+                    assert 'TODO: SPECIAL funct=0x30' not in text
+                    for source in sources:
+                        subprocess.run(['cc','-std=c11','-fsyntax-only','-I',str(sdk/'runtime/include'),str(source)],check=True,capture_output=True)
+                else:
+                    assert 'TODO: SPECIAL funct=0x30' in text
+    print('PASS: reserved guard is explicit and compilable; neighboring reserved word remains unsupported')
+if __name__=='__main__':main()
